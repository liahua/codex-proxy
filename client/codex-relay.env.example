# ============================================================================
# codex-proxy client config  ->  https://codex.liahuas.top
#
# Only two secrets matter, both handed out by the relay server:
#   CHUNK_RELAY_SHARED_SECRET   the simple auth on every relay call
#   CHUNK_RELAY_ENCRYPTION_KEY  the AES-256-GCM key for request+response bodies
# Generate them on the server with: ./scripts/gen-relay-secrets.sh --env
# ============================================================================

# --- where to relay ---------------------------------------------------------
CHUNK_RELAY_ENABLED=true
CHUNK_RELAY_BASE_URL=https://codex.liahuas.top

# --- auth (server-issued) ---------------------------------------------------
CHUNK_RELAY_SHARED_SECRET=replace-me

# --- encryption (server-issued, base64 32 bytes) ----------------------------
# Request chunks AND response frames are both AES-256-GCM under this key.
# The addon refuses to start without it: there is no plaintext relay mode,
# so a misconfiguration can never silently downgrade.
CHUNK_RELAY_ENCRYPTION_KEY=replace-with-base64-32-byte-key
CHUNK_RELAY_ENCRYPTION_KEY_ID=default

# --- chunking ---------------------------------------------------------------
# Keeps every outbound POST well under a 100KB gateway limit.
CHUNK_RELAY_CHUNK_SIZE_BYTES=20480

# --- snapshots (the incremental base) ---------------------------------------
# Latest snapshot per conversation; these hold real request bodies, so the
# byte cap matters more than the count.
CHUNK_RELAY_MAX_SNAPSHOTS=32
CHUNK_RELAY_MAX_SNAPSHOT_BYTES=268435456
CHUNK_RELAY_ZSTD_LEVEL=3

# --- what to intercept ------------------------------------------------------
# The Codex CLI now talks to our own domain with our own secret, so this is the
# host to intercept. The addon skips the relay's own /relay/** uploads to the
# same host, otherwise it would intercept itself and recurse.
CHUNK_RELAY_MATCH_HOSTS=codex.liahuas.top

# --- transport --------------------------------------------------------------
CHUNK_RELAY_TIMEOUT_SECONDS=600
CHUNK_RELAY_UPLOAD_RETRIES=3
CHUNK_RELAY_SSL_VERIFY=true

# --- local mitm -------------------------------------------------------------
MITM_LISTEN_PORT=15334
CHUNK_RELAY_CONSOLE_LOG=true
CHUNK_RELAY_FETCH_REMOTE_BASE=true
