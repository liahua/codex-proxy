# Copy to deploy/.env and fill in with ../scripts/gen-relay-secrets.sh --env

# --- host binding -----------------------------------------------------------
# cloudflared ingress for codex.liahuas.top points at 127.0.0.1:<RELAY_HOST_PORT>
RELAY_HOST_PORT=8788
# docker network created by the CLIProxyAPI compose stack
CPA_NETWORK=cliproxyapi_default

# --- client auth (the single secret the client config needs) ----------------
RELAY_SHARED_SECRET=replace-me

# --- request/response encryption -------------------------------------------
# base64 32-byte AES-256-GCM key, must match CHUNK_RELAY_ENCRYPTION_KEY on the client
RELAY_ENCRYPTION_KEYS={"default":"replace-with-base64-32-byte-key"}

# --- upstream: CPA ----------------------------------------------------------
CPA_BASE_URL=http://cli-proxy-api:8317
CPA_API_KEY=replace-me
# Off by default: whatever model the client asks for goes to CPA unchanged, so
# every model CPA serves is reachable. Only map when you need to alias a name
# CPA does not serve - a silent substitution is worse than a clear error.
# CPA_MODEL_MAP={"gpt-5.1-codex":"gpt-5.5"}
# CPA_FORCE_MODEL=gpt-5.5
# The Codex CLI ships an `image_gen` namespace tool and CPA injects a hosted
# `image_generation` tool; sending both makes the upstream reject the request.
CPA_STRIP_TOOL_NAMES=image_gen
# Drop telemetry (ab.chatgpt.com/otlp/...) instead of relaying it to OpenAI.
CPA_DROP_UNMATCHED=true

# --- retention / logging ----------------------------------------------------
RELAY_REQUEST_TTL_MS=900000
RELAY_SNAPSHOT_TTL_MS=86400000
# Two, not one: a client cannot adopt a snapshot from a response still streaming.
RELAY_KEEP_PER_CONVERSATION=2
RELAY_MAX_SNAPSHOTS=200
RELAY_UPSTREAM_SSL_VERIFY=true
RELAY_DEBUG_LOG=true
